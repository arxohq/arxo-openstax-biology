language "law.core" version "0.2";
package openstax.biology_genetics version "0.1.0";
namespace "urn:openstax:clir:biology-genetics";

test "monohybrid-dominant" {
 given {
  context { decision_time @2026-10-14T12:00:00Z; knowledge_time @2026-10-14T12:00:00Z; legal_time @2026-10-14; timezone "UTC"; }
  assert "monohybrid-dominant-0": heterozygote_cross(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "monohybrid-dominant-1": complete_dominance(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "monohybrid-dominant-2": equal_segregation(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "monohybrid-dominant-3": random_fertilization(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
 }
 evaluate truth(phenotype_probability(entity_ref("urn:case:openstax:biology:demo"), "dominant", 3 / 4));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

