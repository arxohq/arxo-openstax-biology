// Общая часть NCBI Tables 1 и 2. Это 60 строгих правил, а не A3-таблица:
// значение ячейки было бы доменной константой AminoAcid, которую A3 не несёт.
// Какая таблица применима к транскрипту — факт дела `translation_table`
// (как квалификатор `/transl_table` у GenBank), а не выбор прочтения §152:
// две таблицы не спорят об одном кодоне, они действуют в разных геномах.
language "law.core" version "0.2";
package bio.codon version "0.1.1";
namespace "urn:bio:clir:codon";

use self::{
    AAA,
    AAC,
    AAG,
    AAU,
    ACA,
    ACC,
    ACG,
    ACU,
    AGC,
    AGU,
    AUC,
    AUG,
    AUU,
    Ala,
    AminoAcid,
    Arg,
    Asn,
    Asp,
    CAA,
    CAC,
    CAG,
    CAU,
    CCA,
    CCC,
    CCG,
    CCU,
    CGA,
    CGC,
    CGG,
    CGU,
    CUA,
    CUC,
    CUG,
    CUU,
    Codon,
    Cys,
    GAA,
    GAC,
    GAG,
    GAU,
    GCA,
    GCC,
    GCG,
    GCU,
    GGA,
    GGC,
    GGG,
    GGU,
    GUA,
    GUC,
    GUG,
    GUU,
    GeneticCode,
    Gln,
    Glu,
    Gly,
    His,
    Ile,
    Leu,
    Lys,
    Met,
    NCBI_TABLE_1,
    NCBI_TABLE_2,
    Phe,
    Pro,
    Ser,
    Stop,
    Thr,
    Transcript,
    Trp,
    Tyr,
    UAA,
    UAC,
    UAG,
    UAU,
    UCA,
    UCC,
    UCG,
    UCU,
    UGA,
    UGC,
    UGG,
    UGU,
    UUA,
    UUC,
    UUG,
    UUU,
    Val,
};

relation common_codon_product(c: Codon, a: AminoAcid) kind institutional { label ru unofficial "кодон имеет один и тот же продукт в таблицах 1 и 2"; }
relation table_product(g: GeneticCode, c: Codon, a: AminoAcid) kind institutional { label ru unofficial "кодон имеет продукт по названной таблице NCBI"; }
pub relation translation_table(t: Transcript, g: GeneticCode) kind empirical { label ru unofficial "в деле задана таблица NCBI, по которой транслируется транскрипт"; }
pub relation codon_product(t: Transcript, c: Codon, a: AminoAcid) kind institutional { label ru unofficial "кодон имеет продукт по таблице, применимой к транскрипту"; }
pub relation codon_at(t: Transcript, p: Integer, c: Codon) kind empirical { label ru unofficial "в деле задан кодон на позиции рамки"; }
pub relation frame_origin(t: Transcript, p: Integer) kind empirical { label ru unofficial "в деле задано начало рамки считывания"; }
relation frame_boundary(t: Transcript, p: Integer) kind institutional { label ru unofficial "позиция кратна трём относительно заданного начала рамки"; }
relation secis_at(t: Transcript, p: Integer) kind empirical { label ru unofficial "для UGA на позиции установлен SECIS-контекст"; }
relation translation_initiated(t: Transcript, p: Integer) kind institutional { label ru unofficial "трансляция инициирована на AUG"; }
relation translation_elongates_at(t: Transcript, p: Integer, a: AminoAcid) kind institutional { label ru unofficial "на позиции продолжается трансляция с аминокислотой"; }
pub relation translation_stops(t: Transcript, p: Integer) kind institutional { label ru unofficial "трансляция останавливается на терминаторе"; }
relation selenocysteine_incorporated(t: Transcript, p: Integer) kind institutional { label ru unofficial "UGA прочитан как селеноцистеин в SECIS-контексте"; }

@source(NCBI_TABLE_1, NCBI_TABLE_2)
rule UUUIsPhe strict { label ru unofficial "Кодон UUU кодирует фенилаланин"; when true; then common_codon_product(UUU, Phe); }
@source(NCBI_TABLE_1, NCBI_TABLE_2)
