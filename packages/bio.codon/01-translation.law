// Продукт кодона для транскрипта. Общие 60 назначений не зависят от таблицы;
// четыре расходящихся требуют факта дела о применимой таблице: без него UGA,
// AGA, AGG и AUA не получают продукта, и трансляция на них молчит честно.
@source(NCBI_TABLE_1, NCBI_TABLE_2)
rule CommonProductHoldsUnderEitherTable(t: Transcript, p: Integer, c: Codon, a: AminoAcid) strict { label ru unofficial "Общее назначение действует при любой таблице";
    when codon_at(t, p, c) and common_codon_product(c, a);
    then codon_product(t, c, a);
}

@source(NCBI_TABLE_1, NCBI_TABLE_2)
rule TableProductHoldsUnderDeclaredTable(
    t: Transcript,
    p: Integer,
    c: Codon,
    a: AminoAcid,
    g: GeneticCode,
) strict { label ru unofficial "Назначение таблицы действует для транскрипта с этой таблицей";
    when codon_at(t, p, c) and translation_table(t, g) and table_product(g, c, a);
    then codon_product(t, c, a);
}

// `mod` проверяет согласованность уже ЗАДАННОЙ фактом рамки. Это не разбор
// строки РНК и не вычисление frameshift: другой сдвиг приходит другим фактом
// `frame_origin` в другом деле.
@source(NCBI_TABLE_1)
rule PositionFitsGivenFrame(t: Transcript, p: Integer, c: Codon, origin: Integer) strict { label ru unofficial "Позиция принадлежит заданной рамке считывания";
    when codon_at(t, p, c) and frame_origin(t, origin) and ((p - origin) mod 3 == 0);
    then frame_boundary(t, p);
}

@source(NCBI_TABLE_1)
rule AUGInitiatesTranslation(t: Transcript, p: Integer) strict { label ru unofficial "Кодон AUG инициирует трансляцию";
    when codon_at(t, p, AUG) and frame_boundary(t, p);
    then translation_initiated(t, p);
}

@source(NCBI_TABLE_1, NCBI_TABLE_2)
rule AUGContinuesTranslationAsMet(t: Transcript, p: Integer) strict { label ru unofficial "Кодон AUG продолжает трансляцию как метионин";
    when translation_initiated(t, p) and codon_at(t, p, AUG) and frame_boundary(t, p);
    then translation_elongates_at(t, p, Met);
}

@source(NCBI_TABLE_1, NCBI_TABLE_2)
rule StopProductTerminates(t: Transcript, p: Integer, c: Codon) defeasible { label ru unofficial "Терминатор останавливает трансляцию";
    when codon_at(t, p, c) and frame_boundary(t, p) and codon_product(t, c, Stop);
    then translation_stops(t, p);
}

@source(NCBI_TABLE_1)
rule SecisDefeatsUGAStop(t: Transcript, p: Integer) defeater { label ru unofficial "SECIS отменяет остановку на UGA";
    when codon_at(t, p, UGA) and secis_at(t, p);
    defeat translation_stops(t, p);
}

@source(NCBI_TABLE_1)
rule SecisReadsUGAAsSec(t: Transcript, p: Integer) strict { label ru unofficial "SECIS читает UGA как селеноцистеин";
    when codon_at(t, p, UGA) and frame_boundary(t, p) and secis_at(t, p);
    then selenocysteine_incorporated(t, p);
}
