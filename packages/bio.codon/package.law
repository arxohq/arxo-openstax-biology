// `bio.codon`: таблицы NCBI 1 и 2 как одна общая карта и четыре различия,
// действующие по таблице, применимой к транскрипту. Расходятся только AGA,
// AGG, AUA и UGA; остальная карта одна.
language "law.core" version "0.2";
package bio.codon version "0.1.1";
namespace "urn:bio:clir:codon";

pub entity Transcript { label ru unofficial "транскрипт РНК"; }
pub entity Codon { label ru unofficial "кодон РНК"; }
pub entity AminoAcid { label ru unofficial "аминокислота либо терминатор"; }
entity Position { label ru unofficial "позиция в заданной рамке считывания"; }

// Таблицы NCBI, закреплённые пакетом. Это не прочтения одного текста, а
// разные коды разных геномов: применимость к транскрипту задаёт дело.
pub enum GeneticCode {
    Standard,
    VertebrateMitochondrial;
    label ru unofficial "таблица генетического кода NCBI: 1 стандартная, 2 митохондрий позвоночных";
}

const Ala: AminoAcid = entity_ref("urn:bio:clir:codon#Ala") { label ru unofficial "аланин"; };
