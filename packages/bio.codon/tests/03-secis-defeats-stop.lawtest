language "law.core" version "0.2";
package bio.codon version "0.1.1";
namespace "urn:bio:clir:codon";

// При таблице 1 SECIS поражает поражаемую остановку на UGA.
test "urn:query:bio-codon-secis-defeats-stop" {
    given {
        assert "codon-t03-0": translation_table(entity_ref("urn:case:bio:codon:t"), Standard) { origin case_input; }
        assert "codon-t03-1": frame_origin(entity_ref("urn:case:bio:codon:t"), 0) { origin case_input; }
        assert "codon-t03-2": codon_at(entity_ref("urn:case:bio:codon:t"), 0, UGA) { origin case_input; }
        assert "codon-t03-3": secis_at(entity_ref("urn:case:bio:codon:t"), 0) { origin case_input; }
    }
    evaluate truth(translation_stops(entity_ref("urn:case:bio:codon:t"), 0));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
