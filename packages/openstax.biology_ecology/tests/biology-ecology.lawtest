test "disputed-resource-assumption" {
 given {
  context { decision_time @2026-10-14T12:00:00Z; knowledge_time @2026-10-14T12:00:00Z; legal_time @2026-10-14; timezone "UTC"; }
  assert "disputed-resource-assumption-0": bacterial_doubling_profile(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "disputed-resource-assumption-1": unlimited_resources(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "disputed-resource-assumption-2": initial_population(entity_ref("urn:case:openstax:biology:demo"), 1000) { origin case_input; }
  assert "disputed-resource-assumption-3": generation_horizon(entity_ref("urn:case:openstax:biology:demo"), 3) { origin case_input; }
  assert "disputed-resource-assumption-4": not unlimited_resources(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
 }
 evaluate truth(unlimited_resources(entity_ref("urn:case:openstax:biology:demo")));
 expect truth_status == BOTH;
 expect evaluation_status == COMPUTED;
 evaluate truth(population_at_generation(entity_ref("urn:case:openstax:biology:demo"), 3, 8000 / 1));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}

