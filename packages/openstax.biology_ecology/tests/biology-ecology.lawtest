language "law.core" version "0.2";
package openstax.biology_ecology version "0.1.0";
namespace "urn:openstax:clir:biology-ecology";

test "bacterial-doubling" {
 given {
  context { decision_time @2026-10-14T12:00:00Z; knowledge_time @2026-10-14T12:00:00Z; legal_time @2026-10-14; timezone "UTC"; }
  assert "bacterial-doubling-0": bacterial_doubling_profile(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "bacterial-doubling-1": unlimited_resources(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "bacterial-doubling-2": initial_population(entity_ref("urn:case:openstax:biology:demo"), 1000) { origin case_input; }
  assert "bacterial-doubling-3": generation_horizon(entity_ref("urn:case:openstax:biology:demo"), 3) { origin case_input; }
 }
 evaluate truth(population_at_generation(entity_ref("urn:case:openstax:biology:demo"), 0, 1000 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(population_at_generation(entity_ref("urn:case:openstax:biology:demo"), 3, 8000 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(population_at_generation(entity_ref("urn:case:openstax:biology:demo"), 4, 16000 / 1));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}

