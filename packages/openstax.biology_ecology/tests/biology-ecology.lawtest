test "synthetic-food-chain" {
 given {
  context { decision_time @2026-10-14T12:00:00Z; knowledge_time @2026-10-14T12:00:00Z; legal_time @2026-10-14; timezone "UTC"; }
  assert "synthetic-food-chain-0": synthetic_meadow_profile(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "synthetic-food-chain-1": edu.food_webs::claim_chain(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "synthetic-food-chain-2": edu.food_webs::fw_step(entity_ref("urn:case:openstax:biology:demo"), 0, "rabbit", "grass") { origin case_input; }
  assert "synthetic-food-chain-3": edu.food_webs::fw_step(entity_ref("urn:case:openstax:biology:demo"), 1, "fox", "rabbit") { origin case_input; }
 }
 evaluate truth(food_chain_consistent(entity_ref("urn:case:openstax:biology:demo")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

test "invented-feeding-link" {
 given {
  context { decision_time @2026-10-14T12:00:00Z; knowledge_time @2026-10-14T12:00:00Z; legal_time @2026-10-14; timezone "UTC"; }
  assert "invented-feeding-link-0": synthetic_meadow_profile(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "invented-feeding-link-1": edu.food_webs::claim_chain(entity_ref("urn:case:openstax:biology:demo")) { origin case_input; }
  assert "invented-feeding-link-2": edu.food_webs::fw_step(entity_ref("urn:case:openstax:biology:demo"), 0, "fox", "grass") { origin case_input; }
 }
 evaluate truth(food_chain_problem(entity_ref("urn:case:openstax:biology:demo"), "CHAIN_BREAK"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(food_chain_consistent(entity_ref("urn:case:openstax:biology:demo")));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}

