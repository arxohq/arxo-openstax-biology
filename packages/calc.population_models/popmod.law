// -- Forward exponential trajectory (bounded) --------------------------------------
// Claim-free synthesis: from the presented initial size N0 and factor F up
// to the presented horizon bound H. The step rule recurs on pm_derived_traj
// (never on pm_claim_traj, which stays a checker input); the horizon bound
// in both rules keeps the iteration finite. Unbounded iteration stays out:
// without pm_horizon nothing derives. The logistic forward step needs a
// division and sensitivity analysis is new work, both outside this pack.

rule ExpFwdBase(c: PMCase, n0: Rational, h: Integer) strict {
    label en unofficial "the forward trajectory starts at the presented initial size inside the horizon";
    when pm_model(c, "GROWTH_EXP") and pm_param(c, "N0", n0) and pm_horizon(c, h) and h >= 0;
    then pm_derived_traj(c, 0, n0);
}

rule ExpFwdStep(c: PMCase, s: Integer, v: Rational, f: Rational, h: Integer) strict {
    label en unofficial "the forward step multiplies the derived previous value by the presented factor within the horizon";
    when pm_model(c, "GROWTH_EXP") and monotone(pm_derived_traj(c, s, v)) and pm_param(c, "F", f)
        and pm_horizon(c, h) and s + 1 <= h;
    then pm_derived_traj(c, s + 1, v * f);
}

rule ExpFwdHorizonBad(c: PMCase, h: Integer) strict {
    label en unofficial "a horizon below zero refutes the forward growth derivation";
    when pm_model(c, "GROWTH_EXP") and pm_horizon(c, h) and h < 0;
    then pm_error(c, "GROWTH_MISMATCH");
}

// -- Lotka-Volterra equilibrium ------------------------------------------------------

relation lv_equil_ok(
    c: PMCase {
        label en unofficial "task";
    }
) kind institutional {
    label en unofficial "the claimed point is the coexistence equilibrium of the presented rates";
}

rule LvEquilOk(c: PMCase, xv: Rational, yv: Rational, av: Rational, bv: Rational, cv: Rational, dv: Rational) strict {
    label en unofficial "the claimed point matches both cross-multiplied equilibrium steps";
    when pm_model(c, "ECO_LV") and pm_claim_ratio(c, "XEQ", xv) and pm_claim_ratio(c, "YEQ", yv)
        and pm_param(c, "A", av) and pm_param(c, "B", bv)
        and pm_param(c, "C", cv) and pm_param(c, "D", dv)
        and xv * dv == cv and yv * bv == av;
    then lv_equil_ok(c);
}

rule LvEquilBadPrey(c: PMCase, xv: Rational, cv: Rational, dv: Rational) strict {
    label en unofficial "a prey point off the cross-multiplied step mistakes the model";
    when pm_model(c, "ECO_LV") and pm_claim_ratio(c, "XEQ", xv)
        and pm_param(c, "C", cv) and pm_param(c, "D", dv) and xv * dv != cv;
    then pm_error(c, "MODEL_MISMATCH");
}

rule LvEquilBadPred(c: PMCase, yv: Rational, av: Rational, bv: Rational) strict {
    label en unofficial "a predator point off the cross-multiplied step mistakes the model";
    when pm_model(c, "ECO_LV") and pm_claim_ratio(c, "YEQ", yv)
        and pm_param(c, "A", av) and pm_param(c, "B", bv) and yv * bv != av;
    then pm_error(c, "MODEL_MISMATCH");
}

rule LvEquilUnresolvedPrey(c: PMCase, xv: Rational) strict {
    label en unofficial "a prey point without a proved equilibrium is unverifiable";
    when pm_model(c, "ECO_LV") and pm_claim_ratio(c, "XEQ", xv) and not_known(lv_equil_ok(c));
    then pm_error(c, "MODEL_MISMATCH");
}

rule LvEquilUnresolvedPred(c: PMCase, yv: Rational) strict {
    label en unofficial "a predator point without a proved equilibrium is unverifiable";
    when pm_model(c, "ECO_LV") and pm_claim_ratio(c, "YEQ", yv) and not_known(lv_equil_ok(c));
    then pm_error(c, "MODEL_MISMATCH");
}

// -- Verdicts --------------------------------------------------------------------------

relation case_has_error(
    c: PMCase {
        label en unofficial "task";
    }
) kind institutional {
    label en unofficial "at least one step of the task carries an error";
}

rule CaseHasError(c: PMCase, code: Text) strict {
    label en unofficial "any named error taints the task";
    when pm_error(c, code);
    then case_has_error(c);
}

rule PmOkMonoTotal(c: PMCase) strict {
    label en unofficial "a proved monohybrid class sum with no error verifies the task";
    when mono_total_ok(c) and not_known(case_has_error(c));
    then pm_ok(c);
}

rule PmOkMonoRatio(c: PMCase) strict {
    label en unofficial "a proved 3:1 step with no error verifies the task";
    when mono_ratio_ok(c) and not_known(case_has_error(c));
    then pm_ok(c);
}

