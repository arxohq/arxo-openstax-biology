language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

test "trajectory claim on a monohybrid case is MODEL_MISMATCH" {
 given {
  context {
   decision_time @2026-09-27T12:00:00Z;
   knowledge_time @2026-09-27T12:00:00Z;
   legal_time @2026-09-27;
   timezone "UTC";
  }
  assert "f1": pm_model(entity_ref("urn:pm:case14"), "MENDEL_MONO") { origin case_input; }
  assert "f2": pm_param(entity_ref("urn:pm:case14"), "DOM", 225 / 1) { origin case_input; }
  assert "f3": pm_param(entity_ref("urn:pm:case14"), "REC", 75 / 1) { origin case_input; }
  assert "f4": pm_param(entity_ref("urn:pm:case14"), "TOTAL", 300 / 1) { origin case_input; }
  assert "f5": pm_claim_traj(entity_ref("urn:pm:case14"), 0, 225 / 1) { origin case_input; }
 }
 evaluate truth(mono_ratio_ok(entity_ref("urn:pm:case14")));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_error(entity_ref("urn:pm:case14"), "MODEL_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_error(entity_ref("urn:pm:case14"), "GROWTH_MISMATCH"));
 expect truth_status == NEITHER;
 evaluate truth(pm_ok(entity_ref("urn:pm:case14")));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 expect applied(TrajOnStaticModel);
}
