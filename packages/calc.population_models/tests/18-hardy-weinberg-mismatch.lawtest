language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

// Испорченный aa = 1/5 вместо 4/25 — HW_GENO_MISMATCH; остальные генотипы целы.
test "hardy weinberg tampered aa is refused" {
 given {
  context {
   decision_time @2026-10-01T12:00:00Z;
   knowledge_time @2026-10-01T12:00:00Z;
   legal_time @2026-10-01;
   timezone "UTC";
  }
  assert "t1": hw_allele(entity_ref("urn:pm:case18"), 3 / 5, 2 / 5) { origin case_input; }
  assert "t2": hw_pq(entity_ref("urn:pm:case18"), 6 / 25) { origin case_input; }
  assert "t3": hw_geno(entity_ref("urn:pm:case18"), 0, 9 / 1, 25 / 1) { origin case_input; }
  assert "t4": hw_geno(entity_ref("urn:pm:case18"), 1, 12 / 1, 25 / 1) { origin case_input; }
  assert "t5": hw_geno(entity_ref("urn:pm:case18"), 2, 1 / 1, 5 / 1) { origin case_input; }
 }
 evaluate truth(pm_error(entity_ref("urn:pm:case18"), "HW_GENO_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(HwaaBad);
 evaluate truth(hw_geno_ok(entity_ref("urn:pm:case18"), 2));
 expect truth_status == NEITHER;
 evaluate truth(hw_geno_ok(entity_ref("urn:pm:case18"), 0));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_ok(entity_ref("urn:pm:case18")));
 expect truth_status == NEITHER;
}

// Аллели суммой 6/5 — HW_ALLELES_MISMATCH.
test "alleles off one are refused" {
 given {
  context {
   decision_time @2026-10-01T12:00:00Z;
   knowledge_time @2026-10-01T12:00:00Z;
   legal_time @2026-10-01;
   timezone "UTC";
  }
  assert "u1": hw_allele(entity_ref("urn:pm:case18b"), 3 / 5, 3 / 5) { origin case_input; }
  assert "u2": hw_geno(entity_ref("urn:pm:case18b"), 0, 9 / 1, 25 / 1) { origin case_input; }
 }
 evaluate truth(pm_error(entity_ref("urn:pm:case18b"), "HW_ALLELES_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect applied(HwAllelesBad);
 evaluate truth(pm_error(entity_ref("urn:pm:case18b"), "HW_INPUT_INCOMPLETE"));
 expect truth_status == TRUE_ONLY;
 expect applied(HwIncomplete);
 evaluate truth(pm_ok(entity_ref("urn:pm:case18b")));
 expect truth_status == NEITHER;
}
