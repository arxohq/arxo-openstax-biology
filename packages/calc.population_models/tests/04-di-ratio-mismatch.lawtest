language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

test "dihybrid first class 880 off the ninefold step is RATIO_MISMATCH" {
 given {
  context {
   decision_time @2026-09-27T12:00:00Z;
   knowledge_time @2026-09-27T12:00:00Z;
   legal_time @2026-09-27;
   timezone "UTC";
  }
  assert "f1": pm_model(entity_ref("urn:pm:case4"), "MENDEL_DI") { origin case_input; }
  assert "f2": pm_param(entity_ref("urn:pm:case4"), "C1", 880 / 1) { origin case_input; }
  assert "f3": pm_param(entity_ref("urn:pm:case4"), "C2", 300 / 1) { origin case_input; }
  assert "f4": pm_param(entity_ref("urn:pm:case4"), "C3", 300 / 1) { origin case_input; }
  assert "f5": pm_param(entity_ref("urn:pm:case4"), "C4", 100 / 1) { origin case_input; }
  assert "f6": pm_param(entity_ref("urn:pm:case4"), "TOTAL", 1580 / 1) { origin case_input; }
 }
 evaluate truth(di_total_ok(entity_ref("urn:pm:case4")));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_error(entity_ref("urn:pm:case4"), "RATIO_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_error(entity_ref("urn:pm:case4"), "GROWTH_MISMATCH"));
 expect truth_status == NEITHER;
 evaluate truth(pm_ok(entity_ref("urn:pm:case4")));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 expect applied(DiRatioBadFirst);
}
