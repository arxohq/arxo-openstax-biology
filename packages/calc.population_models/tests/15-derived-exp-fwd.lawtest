language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

// N0 = 50/1, F = 2/1, horizon H = 2. Forward synthesis without any claim:
// step 0 = 50, step 1 = 100, step 2 = 200; step 3 is past the bound.

test "exponential forward iterator derives steps 0 to 2 and stops at the horizon" {
 given {
  context {
   decision_time @2026-09-28T12:00:00Z;
   knowledge_time @2026-09-28T12:00:00Z;
   legal_time @2026-09-28;
   timezone "UTC";
  }
  assert "f1": pm_model(entity_ref("urn:pm:case15"), "GROWTH_EXP") { origin case_input; }
  assert "f2": pm_param(entity_ref("urn:pm:case15"), "N0", 50 / 1) { origin case_input; }
  assert "f3": pm_param(entity_ref("urn:pm:case15"), "F", 2 / 1) { origin case_input; }
  assert "f4": pm_horizon(entity_ref("urn:pm:case15"), 2) { origin case_input; }
 }
 evaluate truth(pm_derived_traj(entity_ref("urn:pm:case15"), 0, 50 / 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_derived_traj(entity_ref("urn:pm:case15"), 1, 100 / 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_derived_traj(entity_ref("urn:pm:case15"), 2, 200 / 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_derived_traj(entity_ref("urn:pm:case15"), 2, 201 / 1));
 expect truth_status == NEITHER;
 evaluate truth(pm_derived_traj(entity_ref("urn:pm:case15"), 3, 400 / 1));
 expect truth_status == NEITHER;
 evaluate truth(pm_error(entity_ref("urn:pm:case15"), "GROWTH_MISMATCH"));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 expect applied(ExpFwdStep);
}
