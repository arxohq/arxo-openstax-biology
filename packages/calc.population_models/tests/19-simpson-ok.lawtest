language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

// Доли 1/2, 1/3, 1/6: D = 1/4 + 1/9 + 1/36 = 7/18.
// Второй путь — через попарные произведения: 1 − D = 11/18.
test "simpson dominance proves" {
 given {
  context {
   decision_time @2026-10-01T12:00:00Z;
   knowledge_time @2026-10-01T12:00:00Z;
   legal_time @2026-10-01;
   timezone "UTC";
  }
  assert "v1": eco_share(entity_ref("urn:pm:case19"), 0, 1 / 2) { origin case_input; }
  assert "v2": eco_share(entity_ref("urn:pm:case19"), 1, 1 / 3) { origin case_input; }
  assert "v3": eco_share(entity_ref("urn:pm:case19"), 2, 1 / 6) { origin case_input; }
  assert "v4": eco_simpson(entity_ref("urn:pm:case19"), 7 / 1, 18 / 1) { origin case_input; }
 }
 evaluate truth(eco_shares_ok(entity_ref("urn:pm:case19")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(SharesOk);
 evaluate truth(simpson_ok(entity_ref("urn:pm:case19")));
 expect truth_status == TRUE_ONLY;
 expect applied(SimpsonOk);
 evaluate truth(pm_error(entity_ref("urn:pm:case19"), "SIMPSON_MISMATCH"));
 expect truth_status == NEITHER;
 evaluate truth(pm_ok(entity_ref("urn:pm:case19")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(PmOkSimpson);
}
