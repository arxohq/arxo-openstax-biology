language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

test "Lotka-Volterra rates 2 1 3 1 prove the equilibrium 3 2" {
 given {
  context {
   decision_time @2026-09-27T12:00:00Z;
   knowledge_time @2026-09-27T12:00:00Z;
   legal_time @2026-09-27;
   timezone "UTC";
  }
  assert "f1": pm_model(entity_ref("urn:pm:case11"), "ECO_LV") { origin case_input; }
  assert "f2": pm_param(entity_ref("urn:pm:case11"), "A", 2 / 1) { origin case_input; }
  assert "f3": pm_param(entity_ref("urn:pm:case11"), "B", 1 / 1) { origin case_input; }
  assert "f4": pm_param(entity_ref("urn:pm:case11"), "C", 3 / 1) { origin case_input; }
  assert "f5": pm_param(entity_ref("urn:pm:case11"), "D", 1 / 1) { origin case_input; }
  assert "f6": pm_claim_ratio(entity_ref("urn:pm:case11"), "XEQ", 3 / 1) { origin case_input; }
  assert "f7": pm_claim_ratio(entity_ref("urn:pm:case11"), "YEQ", 2 / 1) { origin case_input; }
 }
 evaluate truth(lv_equil_ok(entity_ref("urn:pm:case11")));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_ok(entity_ref("urn:pm:case11")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(LvEquilOk);
}
