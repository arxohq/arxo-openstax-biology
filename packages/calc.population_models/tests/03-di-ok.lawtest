language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

test "dihybrid 900 300 300 100 of 1600 proves the 9:3:3:1 steps" {
 given {
  context {
   decision_time @2026-09-27T12:00:00Z;
   knowledge_time @2026-09-27T12:00:00Z;
   legal_time @2026-09-27;
   timezone "UTC";
  }
  assert "f1": pm_model(entity_ref("urn:pm:case3"), "MENDEL_DI") { origin case_input; }
  assert "f2": pm_param(entity_ref("urn:pm:case3"), "C1", 900 / 1) { origin case_input; }
  assert "f3": pm_param(entity_ref("urn:pm:case3"), "C2", 300 / 1) { origin case_input; }
  assert "f4": pm_param(entity_ref("urn:pm:case3"), "C3", 300 / 1) { origin case_input; }
  assert "f5": pm_param(entity_ref("urn:pm:case3"), "C4", 100 / 1) { origin case_input; }
  assert "f6": pm_param(entity_ref("urn:pm:case3"), "TOTAL", 1600 / 1) { origin case_input; }
 }
 evaluate truth(di_total_ok(entity_ref("urn:pm:case3")));
 expect truth_status == TRUE_ONLY;
 evaluate truth(di_ratio_ok(entity_ref("urn:pm:case3")));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_ok(entity_ref("urn:pm:case3")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(DiRatioOk);
}
