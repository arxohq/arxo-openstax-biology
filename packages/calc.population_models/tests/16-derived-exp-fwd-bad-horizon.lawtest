language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

test "negative horizon refuses the forward derivation" {
 given {
  context {
   decision_time @2026-09-28T12:00:00Z;
   knowledge_time @2026-09-28T12:00:00Z;
   legal_time @2026-09-28;
   timezone "UTC";
  }
  assert "f1": pm_model(entity_ref("urn:pm:case16"), "GROWTH_EXP") { origin case_input; }
  assert "f2": pm_param(entity_ref("urn:pm:case16"), "N0", 50 / 1) { origin case_input; }
  assert "f3": pm_param(entity_ref("urn:pm:case16"), "F", 2 / 1) { origin case_input; }
  assert "f4": pm_horizon(entity_ref("urn:pm:case16"), -1) { origin case_input; }
 }
 evaluate truth(pm_error(entity_ref("urn:pm:case16"), "GROWTH_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_derived_traj(entity_ref("urn:pm:case16"), 0, 50 / 1));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 expect applied(ExpFwdHorizonBad);
}
