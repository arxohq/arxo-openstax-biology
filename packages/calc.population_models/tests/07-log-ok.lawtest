language "law.core" version "0.2";
package calc.population_models version "0.1.0";
namespace "urn:law:calc:population-models";

test "logistic R 1 K 1000 proves the 100 to 190 step" {
 given {
  context {
   decision_time @2026-09-27T12:00:00Z;
   knowledge_time @2026-09-27T12:00:00Z;
   legal_time @2026-09-27;
   timezone "UTC";
  }
  assert "f1": pm_model(entity_ref("urn:pm:case7"), "GROWTH_LOG") { origin case_input; }
  assert "f2": pm_param(entity_ref("urn:pm:case7"), "N0", 100 / 1) { origin case_input; }
  assert "f3": pm_param(entity_ref("urn:pm:case7"), "R", 1 / 1) { origin case_input; }
  assert "f4": pm_param(entity_ref("urn:pm:case7"), "K", 1000 / 1) { origin case_input; }
  assert "f5": pm_claim_traj(entity_ref("urn:pm:case7"), 0, 100 / 1) { origin case_input; }
  assert "f6": pm_claim_traj(entity_ref("urn:pm:case7"), 1, 190 / 1) { origin case_input; }
 }
 evaluate truth(log_base_ok(entity_ref("urn:pm:case7")));
 expect truth_status == TRUE_ONLY;
 evaluate truth(log_step_ok(entity_ref("urn:pm:case7"), 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(pm_ok(entity_ref("urn:pm:case7")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(LogStepOk);
}
