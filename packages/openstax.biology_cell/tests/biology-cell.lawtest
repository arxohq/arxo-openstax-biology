language "law.core" version "0.2";
package openstax.biology_cell version "0.1.0";
namespace "urn:openstax:clir:biology-cell";

test "ribosome-function" {
 given {
  context { decision_time @2026-10-14T12:00:00Z; knowledge_time @2026-10-14T12:00:00Z; legal_time @2026-10-14; timezone "UTC"; }
  assert "ribosome-function-0": presented_structure(entity_ref("urn:case:openstax:biology:demo"), "ribosome") { origin case_input; }
 }
 evaluate truth(function_of(entity_ref("urn:case:openstax:biology:demo"), "ribosome", "protein-synthesis"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}

