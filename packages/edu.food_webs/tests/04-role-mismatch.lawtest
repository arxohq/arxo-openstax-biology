language "law.core" version "0.2";
package edu.food_webs version "0.1.0";
namespace "urn:edu:clir:food-webs";

test "herbivore fox is refused" {
 given {
  assert "t4-r": fw_roleclaim(entity_ref("urn:edu:bio:t4"), "fox", "herbivore") { origin case_input; }
  assert "t4-cr": claim_roles(entity_ref("urn:edu:bio:t4")) { origin case_input; }
 }
 evaluate truth(fw_error(entity_ref("urn:edu:bio:t4"), "ROLE_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 evaluate truth(roles_ok(entity_ref("urn:edu:bio:t4")));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 expect applied(RoleMismatch);
}
