language "law.core" version "0.2";
package edu.food_webs version "0.1.0";
namespace "urn:edu:clir:food-webs";

test "invented fox grass link is refused" {
 given {
  assert "t2-s1": fw_step(entity_ref("urn:edu:bio:t2"), 1, "fox", "grass") { origin case_input; }
  assert "t2-cc": claim_chain(entity_ref("urn:edu:bio:t2")) { origin case_input; }
 }
 evaluate truth(fw_error(entity_ref("urn:edu:bio:t2"), "CHAIN_BREAK"));
 expect truth_status == TRUE_ONLY;
 evaluate truth(chain_ok(entity_ref("urn:edu:bio:t2")));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 expect applied(BreakLoud);
}
