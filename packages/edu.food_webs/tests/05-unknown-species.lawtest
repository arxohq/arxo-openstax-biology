language "law.core" version "0.2";
package edu.food_webs version "0.1.0";
namespace "urn:edu:clir:food-webs";

test "chain through an out-of-web species stays silent" {
 given {
  assert "t5-s1": fw_step(entity_ref("urn:edu:bio:t5"), 1, "fox", "rabbit") { origin case_input; }
  assert "t5-s2": fw_step(entity_ref("urn:edu:bio:t5"), 2, "rabbit", "quorfleaf") { origin case_input; }
  assert "t5-cc": claim_chain(entity_ref("urn:edu:bio:t5")) { origin case_input; }
 }
 evaluate truth(chain_ok(entity_ref("urn:edu:bio:t5")));
 expect truth_status == NEITHER;
 evaluate truth(fw_error(entity_ref("urn:edu:bio:t5"), "CHAIN_BREAK"));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
