language "law.core" version "0.2";
package edu.food_webs version "0.1.0";
namespace "urn:edu:clir:food-webs";

test "fox rabbit grass chain is unbroken" {
 given {
  assert "t1-s1": fw_step(entity_ref("urn:edu:bio:t1"), 1, "fox", "rabbit") { origin case_input; }
  assert "t1-s2": fw_step(entity_ref("urn:edu:bio:t1"), 2, "rabbit", "grass") { origin case_input; }
  assert "t1-cc": claim_chain(entity_ref("urn:edu:bio:t1")) { origin case_input; }
 }
 evaluate truth(chain_ok(entity_ref("urn:edu:bio:t1")));
 expect truth_status == TRUE_ONLY;
 evaluate truth(fw_error(entity_ref("urn:edu:bio:t1"), "CHAIN_BREAK"));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 expect applied(ChainOk);
}
