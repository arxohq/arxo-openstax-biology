language "law.core" version "0.2";
package calc.probability_spaces version "0.1.0";
namespace "urn:law:calc:probability-spaces";

test "die: P(even | small) claimed as 1/3 is a conditional mismatch" {
 given {
  assert "f0": pspace(entity_ref("urn:calc:prob:p6")) { origin case_input; }
  assert "f1": outcome(entity_ref("urn:calc:prob:p6"), 1, 1, 6) { origin case_input; }
  assert "f2": outcome(entity_ref("urn:calc:prob:p6"), 2, 1, 6) { origin case_input; }
  assert "f3": outcome(entity_ref("urn:calc:prob:p6"), 3, 1, 6) { origin case_input; }
  assert "f4": outcome(entity_ref("urn:calc:prob:p6"), 4, 1, 6) { origin case_input; }
  assert "f5": outcome(entity_ref("urn:calc:prob:p6"), 5, 1, 6) { origin case_input; }
  assert "f6": outcome(entity_ref("urn:calc:prob:p6"), 6, 1, 6) { origin case_input; }
  assert "f7": member(entity_ref("urn:calc:prob:p6"), "even", 2) { origin case_input; }
  assert "f8": member(entity_ref("urn:calc:prob:p6"), "even", 4) { origin case_input; }
  assert "f9": member(entity_ref("urn:calc:prob:p6"), "even", 6) { origin case_input; }
  assert "f10": member(entity_ref("urn:calc:prob:p6"), "small", 1) { origin case_input; }
  assert "f11": member(entity_ref("urn:calc:prob:p6"), "small", 2) { origin case_input; }
  assert "f12": member(entity_ref("urn:calc:prob:p6"), "small", 3) { origin case_input; }
  assert "f13": member(entity_ref("urn:calc:prob:p6"), "small", 4) { origin case_input; }
  assert "f14": cond_claim(entity_ref("urn:calc:prob:p6"), "even", "small", 1 / 3) { origin case_input; }
 }
 evaluate truth(prob_error(entity_ref("urn:calc:prob:p6"), "CONDITIONAL_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(CondLow);
}
