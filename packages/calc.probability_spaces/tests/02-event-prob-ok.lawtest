language "law.core" version "0.2";
package calc.probability_spaces version "0.1.0";
namespace "urn:law:calc:probability-spaces";

test "thirds normalize exactly: P({1,2}) = 2/3 verifies" {
 given {
  assert "f0": pspace(entity_ref("urn:calc:prob:p2")) { origin case_input; }
  assert "f1": outcome(entity_ref("urn:calc:prob:p2"), 1, 1, 3) { origin case_input; }
  assert "f2": outcome(entity_ref("urn:calc:prob:p2"), 2, 1, 3) { origin case_input; }
  assert "f3": outcome(entity_ref("urn:calc:prob:p2"), 3, 1, 3) { origin case_input; }
  assert "f4": member(entity_ref("urn:calc:prob:p2"), "low", 1) { origin case_input; }
  assert "f5": member(entity_ref("urn:calc:prob:p2"), "low", 2) { origin case_input; }
  assert "f6": prob_claim(entity_ref("urn:calc:prob:p2"), "low", 2 / 3) { origin case_input; }
 }
 evaluate truth(prob_ok(entity_ref("urn:calc:prob:p2")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(ProbOk);
}
