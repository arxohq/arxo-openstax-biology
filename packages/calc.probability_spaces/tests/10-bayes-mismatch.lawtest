language "law.core" version "0.2";
package calc.probability_spaces version "0.1.0";
namespace "urn:law:calc:probability-spaces";

test "posterior P(hyp | ev) claimed as 1/4 is a Bayes mismatch" {
 given {
  assert "f0": pspace(entity_ref("urn:calc:prob:p10")) { origin case_input; }
  assert "f1": outcome(entity_ref("urn:calc:prob:p10"), 1, 1, 4) { origin case_input; }
  assert "f2": outcome(entity_ref("urn:calc:prob:p10"), 2, 1, 4) { origin case_input; }
  assert "f3": outcome(entity_ref("urn:calc:prob:p10"), 3, 1, 4) { origin case_input; }
  assert "f4": outcome(entity_ref("urn:calc:prob:p10"), 4, 1, 4) { origin case_input; }
  assert "f5": member(entity_ref("urn:calc:prob:p10"), "hyp", 1) { origin case_input; }
  assert "f6": member(entity_ref("urn:calc:prob:p10"), "hyp", 2) { origin case_input; }
  assert "f7": member(entity_ref("urn:calc:prob:p10"), "ev", 2) { origin case_input; }
  assert "f8": member(entity_ref("urn:calc:prob:p10"), "ev", 3) { origin case_input; }
  assert "f9": bayes_claim(entity_ref("urn:calc:prob:p10"), "hyp", "ev", 1 / 4) { origin case_input; }
 }
 evaluate truth(prob_error(entity_ref("urn:calc:prob:p10"), "BAYES_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(BayesLow);
}
