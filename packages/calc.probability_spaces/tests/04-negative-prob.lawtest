language "law.core" version "0.2";
package calc.probability_spaces version "0.1.0";
namespace "urn:law:calc:probability-spaces";

test "a negative presented probability is NEGATIVE_PROB" {
 given {
  assert "f0": pspace(entity_ref("urn:calc:prob:p4")) { origin case_input; }
  assert "f1": outcome(entity_ref("urn:calc:prob:p4"), 1, 1, 2) { origin case_input; }
  assert "f2": outcome(entity_ref("urn:calc:prob:p4"), 2, 3, 4) { origin case_input; }
  assert "f3": outcome(entity_ref("urn:calc:prob:p4"), 3, -1, 4) { origin case_input; }
 }
 evaluate truth(prob_error(entity_ref("urn:calc:prob:p4"), "NEGATIVE_PROB"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(NegativeProbError);
}
