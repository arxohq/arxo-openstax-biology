language "law.core" version "0.2";
package calc.probability_spaces version "0.1.0";
namespace "urn:law:calc:probability-spaces";

test "probabilities summing to 5/6 are a sum mismatch" {
 given {
  assert "f0": pspace(entity_ref("urn:calc:prob:p3")) { origin case_input; }
  assert "f1": outcome(entity_ref("urn:calc:prob:p3"), 1, 1, 2) { origin case_input; }
  assert "f2": outcome(entity_ref("urn:calc:prob:p3"), 2, 1, 3) { origin case_input; }
 }
 evaluate truth(prob_error(entity_ref("urn:calc:prob:p3"), "PROBS_SUM_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(SumMismatchLow);
}
