language "law.core" version "0.2";
package openstax.biology_evolution version "0.1.0";
namespace "urn:openstax:clir:biology-evolution";

import calc.population_models version "0.1.0";
use self::{
    PIN_HW_ASSUMPTIONS,
    PIN_HW_GENOTYPES,
    PIN_NONRANDOM_MATING,
};
pub relation random_mating(c: calc.population_models::PMCase) kind empirical { label en unofficial "random mating supplied as a model assumption"; }
pub relation ideal_infinite_population(c: calc.population_models::PMCase) kind empirical { label en unofficial "ideal infinite population; not an observed claim about a finite population"; }
pub relation no_mutation(c: calc.population_models::PMCase) kind empirical { label en unofficial "no mutation assumed"; }
pub relation no_migration(c: calc.population_models::PMCase) kind empirical { label en unofficial "no immigration or emigration assumed"; }
pub relation no_selection(c: calc.population_models::PMCase) kind empirical { label en unofficial "no genotype selection assumed"; }
pub relation allele_frequencies(c: calc.population_models::PMCase, p: Rational, q: Rational) kind empirical { label en unofficial "supplied frequencies of the two alleles"; }
pub relation random_mating_established(c: calc.population_models::PMCase) kind institutional { label en unofficial "the supplied random-mating assumption is established"; }
pub relation hardy_weinberg_licensed(c: calc.population_models::PMCase) kind institutional { label en unofficial "the ideal diallelic equilibrium model is licensed"; }
pub relation genotype_frequency(c: calc.population_models::PMCase, genotype: Text, f: Rational) kind institutional { label en unofficial "calculated genotype frequency under the ideal model"; }
pub relation invalid_allele_frequencies(c: calc.population_models::PMCase) kind institutional { label en unofficial "supplied allele frequencies fail the probability domain"; }
@source(PIN_NONRANDOM_MATING)
pub rule RandomMatingEstablished(c: calc.population_models::PMCase) strict { label en unofficial "random mating is an explicit prerequisite"; when random_mating(c); then random_mating_established(c); }
@source(PIN_HW_ASSUMPTIONS)
pub rule HardyWeinbergLicensed(c: calc.population_models::PMCase, p: Rational, q: Rational) strict { label en unofficial "all ideal-model conditions and frequency bounds are established"; when random_mating_established(c) and ideal_infinite_population(c) and no_mutation(c) and no_migration(c) and no_selection(c) and allele_frequencies(c, p, q) and p >= 0 / 1 and q >= 0 / 1 and p <= 1 / 1 and q <= 1 / 1 and p + q == 1 / 1 and (count distinct p2: Rational for q2: Rational where allele_frequencies(c, p2, q2)) == 1 and (count distinct q2: Rational for p2: Rational where allele_frequencies(c, p2, q2)) == 1; then hardy_weinberg_licensed(c); }
@source(PIN_HW_GENOTYPES)
pub rule SupplyAlleles(c: calc.population_models::PMCase, p: Rational, q: Rational) strict { label en unofficial "licensed frequencies enter the existing population calculator"; when hardy_weinberg_licensed(c) and allele_frequencies(c, p, q); then calc.population_models::hw_allele(c, p, q); }
@source(PIN_HW_GENOTYPES)
pub rule GenotypeAA(c: calc.population_models::PMCase, f: Rational) strict { label en unofficial "frequency of AA calculated by the shared population model"; when hardy_weinberg_licensed(c) and calc.population_models::hw_geno_built(c, 0, f); then genotype_frequency(c, "AA", f); }
@source(PIN_HW_GENOTYPES)
pub rule GenotypeAa(c: calc.population_models::PMCase, f: Rational) strict { label en unofficial "frequency of Aa calculated by the shared population model"; when hardy_weinberg_licensed(c) and calc.population_models::hw_geno_built(c, 1, f); then genotype_frequency(c, "Aa", f); }
@source(PIN_HW_GENOTYPES)
pub rule Genotypeaa(c: calc.population_models::PMCase, f: Rational) strict { label en unofficial "frequency of aa calculated by the shared population model"; when hardy_weinberg_licensed(c) and calc.population_models::hw_geno_built(c, 2, f); then genotype_frequency(c, "aa", f); }
pub rule InvalidNegativeAllele(c: calc.population_models::PMCase, p: Rational, q: Rational) strict { label en unofficial "negative allele frequencies fail the domain"; when allele_frequencies(c, p, q) and (p < 0 / 1 or q < 0 / 1); then invalid_allele_frequencies(c); }
pub rule InvalidAlleleTotal(c: calc.population_models::PMCase, p: Rational, q: Rational) strict { label en unofficial "two allele frequencies must close on one"; when allele_frequencies(c, p, q) and p + q != 1 / 1; then invalid_allele_frequencies(c); }
