ind":"value","type":{"name":"urn:law:std#Integer"},"value":0}],"kind":"literal","polarity":"positive","predicate":"urn:law:calc:probability-spaces#rv_value"},"id":"urn:openstax:clir:biology-genetics#DominantIndicator3","interpretations":[],"kind":"rule","labels":[{"language":"en","status":"unofficial","text":"dominant phenotype indicator for outcome 3"}],"package":"urn:openstax:clir:biology-genetics","scope":{"kind":"boolean","value":true},"strength":"strict","variables":[{"id":"v0","type":{"name":"calc.probability_spaces#PCases"}}],"visibility":"public"},{"anchors":["urn:openstax:clir:biology-genetics#PIN_DOMINANCE"],"body":{"items":[{"formula":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-genetics#heterozygote_cross"},"kind":"status","status":"established"},{"formula":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-genetics#equal_segregation"},"kind":"status","status":"established"},{"formula":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-genetics#complete_dominance"},"kind":"status","status":"established"},{"formula":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-genetics#random_fertilization"},"kind":"status","status":"established"}],"kind":"and"},"contentHash":"sha256:5c427c895ec6dcdb74f9a56d4b6d307866fcc46e952dc74f4d0d49bc1542b57d","head":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-genetics#monohybrid_licensed"},"id":"urn:openstax:clir:biology-genetics#MonohybridLicensed","interpretations":[],"kind":"rule","labels":[{"language":"en","status":"unofficial","text":"all explicit single-locus cross assumptions are established"}],"package":"urn:openstax:clir:biology-genetics","scope":{"kind":"boolean","value":true},"strength":"strict","variables":[{"id":"v0","type":{"name":"calc.probability_spaces#PCases"}}],"visibility":"public"},{"contentHash":"sha256:b5aeda401128bca5e717bcd7e2d89d568969c234d12583e92839ebdee8fb44a0","edition":"urn:openstax:clir:biology-genetics#S_15_1_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-genetics#PIN_CODE","kind":"fragment","locator":"section/15.1#pin_code","package":"urn:openstax:clir:biology-genetics","texts":[{"contentHash":"sha256:55cc017d1f66c7b6fb23d7a46c692aa48c692cb2afb3610f343bc8fb0bb43ccf","language":"en","status":"official","text":"The genetic code is nearly universal. With a few minor exceptions, virtually all species use the same genetic code for protein synthesis. Conservation of codons means that a purified mRNA encoding the globin protein in horses could be transferred to a tulip cell, and the tulip would synthesize horse globin. That there is only one genetic code is powerful evidence that all of life on Earth shares a common origin, especially considering that there are about 1084 possible combinations of 20 amino acids and 64 triplet codons."}],"visibility":"public"},{"contentHash":"sha256:f6490d186b6495a73aba78e699a58ac7c4396de73c602e9d24a64d890699f0f5","edition":"urn:openstax:clir:biology-genetics#S_12_2_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-genetics#PIN_DOMINANCE","kind":"fragment","locator":"section/12.2#pin_dominance","package":"urn:openstax:clir:biology-genetics","texts":[{"contentHash":"sha256:a84bd8c415d4f6dbd34c84f986b665cb2b3708d5eeee78ee15348919725b378f","language":"en","status":"official","text":"Our discussion of homozygous and heterozygous organisms brings us to why the F1 heterozygous offspring were identical to one of the parents, rather than expressing both alleles. In all seven pea-plant characteristics, one of the two contrasting alleles was dominant, and the other was recessive. Mendel called the dominant allele the expressed unit factor; the recessive allele was referred to as the latent unit factor. We now know that these so-called unit factors are actually genes on homologous chromosome pairs. For a gene that is expressed in a dominant and recessive pattern, homozygous dominant and heterozygous organisms will look identical (that is, they will have different genotypes but the same phenotype). The traits of the recessive allele will only be observed in homozygous recessive individuals (Table 12.4)."}],"visibility":"public"},{"contentHash":"sha256:416a88062377536319c7b908375c6234cf3c839385d00fbba00f439045eb809f","edition":"urn:openstax:clir:biology-genetics#S_12_2_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-genetics#PIN_PUNNETT","kind":"fragment","locator":"section/12.2#pin_punnett","package":"urn:openstax:clir:biology-genetics","texts":[{"contentHash":"sha256:3ebc1be7d4fdbbfe7cb1a95fd746910c830fe82db3d85f628406ac3a36d43618","language":"en","status":"official","text":"A self-cross of one of the Yy heterozygous offspring can be represented in a 2 × 2 Punnett square because each parent can donate one of two different alleles. Therefore, the offspring can potentially have one of four allele combinations: YY, Yy, yY, or yy (Figure 12.4). Notice that there are two ways to obtain the Yy genotype: a Y from the egg and a y from the sperm, or a y from the egg and a Y from the sperm. Both of these possibilities must be counted. Recall that Mendel’s pea-plant characteristics behaved in the same way in reciprocal crosses. Therefore, the two possible heterozygous combinations produce offspring that are genotypically and phenotypically identical despite their dominant and recessive alleles deriving from different parents. They are grouped together. Because fertilization is a random event, we expect each combination to be equally likely and for the offspring to exhibit a ratio of YY:Yy:yy genotypes of 1:2:1 (Figure 12.4). Furthermore, because the YY and Yy offspring have yellow seeds and are phenotypically identical, applying the sum rule of probability, we expect the offspring to exhibit a phenotypic ratio of 3 yellow:1 green. Indeed, working with large sample sizes, Mendel observed approximately this ratio in every F2 generation resulting from crosses for individual traits."}],"visibility":"public"},{"contentHash":"sha256:37dd617711ec609c928a227d1bb54a72156c97965132c30ef6b4dba66b79ac00","edition":"urn:openstax:clir:biology-genetics#S_12_3_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-genetics#PIN_SEGREGATION","kind":"fragment","locator":"section/12.3#pin_segregation","package":"urn:openstax:clir:biology-genetics","texts":[{"contentHash":"sha256:175a189b6fed9b33f40bdc41f8fdc59901a1fe9ad4cac92eb50b12c75d2ea4fa","language":"en","status":"official","text":"Observing that true-breeding pea plants with contrasting traits gave rise to F1 generations that all expressed the dominant trait and F2 generations that expressed the dominant and recessive traits in a 3:1 ratio, Mendel proposed the law of segregation. This law states that paired unit factors (genes) must segregate equally into gametes such that offspring have an equal likelihood of inheriting either factor. For the F2 generation of a monohybrid cross, the following three possible combinations of genotypes could result: homozygous dominant, heterozygous, or homozygous recessive. Because heterozygotes could arise from two different pathways (receiving one dominant and one recessive allele from either parent), and because heterozygotes and homozygous dominant individuals are phenotypically identical, the law supports Mendel’s observed 3:1 phenotypic ratio. The equal segregation of alleles is the reason we can apply the Punnett square to accurately predict the offspring of parents with known genotypes. The physical basis of Mendel’s law of segregation is the first division of meiosis, in which the homologous chromosomes with their different versions of each gene are segregated into daughter nuclei. The role of the meiotic segregation of chromosomes in sexual reproduction was not understood by the scientific community during Mendel’s lifetime."}],"visibility":"public"},{"body":{"items":[{"formula":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"},{"kind":"var","var":"v2"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-genetics#phenotype_claim"},"kind":"status","status":"established"},{"kind":"comparison","left":{"kind":"var","var":"v2"},"op":"ne","right":{"kind":"var","var":"v3"}},{"formula":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"},{"kind":"var","var":"v3"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-genetics#phenotype_probability"},"kind":"status","status":"established"}],"kind":"and"},"contentHash":"sha256:417fbe571591da07176868f60a02366c6aaddec6d34314ddb87857e8c79ef0a1","head":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"},{"kind":"var","var":"v2"}],"kind":"literal","polarity":"negative","predicate":"urn:openstax:clir:biology-genetics#phenotype_claim_supported"},"id":"urn:openstax:clir:biology-genetics#PhenotypeClaimRefuted","interpretations":[],"kind":"rule","labels":[{"language":"en","status":"unofficial","text":"a proposed phenotype probability different from the calculated value is refuted"}],"package":"urn:openstax:clir:biology-genetics","scope":{"kind":"boolean","value":true},"strength":"strict","variables":[{"id":"v0","type":{"name":"calc.probability_spaces#PCases"}},{"id":"v1","type":{"name":"urn:law:std#Text"}},{"id":"v2","type":{"name":"urn:law:std#Rational"}},{"id":"v3","type":{"name":"urn:law:std#Rational"}}],"visibility":"public"},{"body":{"items":[{"formula":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"},{"kind":"var","var":"v2"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-genetics#phenotype_claim"},"kind":"status","status":"established"},{"formula":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"},{"kind":"var","va