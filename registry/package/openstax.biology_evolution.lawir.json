law:std#Rational"}},{"id":"v2","type":{"name":"urn:law:std#Rational"}}],"visibility":"public"},{"body":{"items":[{"kind":"comparison","left":{"kind":"var","var":"v2"},"op":"lt","right":{"kind":"binary","left":{"kind":"value","type":{"name":"urn:law:std#Number"},"value":"0/1"},"op":"div","right":{"kind":"value","type":{"name":"urn:law:std#Number"},"value":"1/1"}}},{"formula":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"},{"kind":"var","var":"v2"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-evolution#allele_frequencies"},"kind":"status","status":"established"}],"kind":"and"},"contentHash":"sha256:1614d95674b8b403c07b5109d77c754d547ac9d0bf759c9189f583663aecdcb1","head":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-evolution#invalid_allele_frequencies"},"id":"urn:openstax:clir:biology-evolution#InvalidNegativeAllele/alt/2","interpretations":[],"kind":"rule","labels":[{"language":"en","status":"unofficial","text":"negative allele frequencies fail the domain"}],"package":"urn:openstax:clir:biology-evolution","scope":{"kind":"boolean","value":true},"strength":"strict","variables":[{"id":"v0","type":{"name":"calc.population_models#PMCase"}},{"id":"v1","type":{"name":"urn:law:std#Rational"}},{"id":"v2","type":{"name":"urn:law:std#Rational"}}],"visibility":"public"},{"contentHash":"sha256:6002b4f4a33971829d4d10072a69b7d2d2eb0c673e5a3b3a10edbca75568eeed","edition":"urn:openstax:clir:biology-evolution#S_19_1_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-evolution#PIN_HW_ASSUMPTIONS","kind":"fragment","locator":"section/19.1#pin_hw_assumptions","package":"urn:openstax:clir:biology-evolution","texts":[{"contentHash":"sha256:3545ec532f6f302b6a672657c4474fdcb8c2af78f791b2245fdb1280544521d1","language":"en","status":"official","text":"In the early twentieth century, English mathematician Godfrey Hardy and German physician Wilhelm Weinberg stated the principle of equilibrium to describe the population's genetic makeup. The theory, which later became known as the Hardy-Weinberg principle of equilibrium, states that a population’s allele and genotype frequencies are inherently stable—unless some kind of evolutionary force is acting upon the population, neither the allele nor the genotypic frequencies would change. The Hardy-Weinberg principle assumes an infinitely large population and conditions with no mutations, migration, emigration, or selective pressure for or against genotype. While no population can satisfy those conditions, the principle offers a useful model against which to compare real population changes."}],"visibility":"public"},{"contentHash":"sha256:ed1b5860b0a8cca1bd8da50458da20bf099037933abcb58c6c4a0a240a5788ce","edition":"urn:openstax:clir:biology-evolution#S_19_1_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-evolution#PIN_HW_GENOTYPES","kind":"fragment","locator":"section/19.1#pin_hw_genotypes","package":"urn:openstax:clir:biology-evolution","texts":[{"contentHash":"sha256:b31913f12cca4179f4864e227a5617dbc9c34460f105104acbc93ec9c199de5b","language":"en","status":"official","text":"However, what ultimately interests most biologists is not the frequencies of different alleles, but the frequencies of the resulting genotypes, known as the population’s genetic structure, from which scientists can surmise phenotype distribution. If we observe the phenotype, we can know only the homozygous recessive allele's genotype. The calculations provide an estimate of the remaining genotypes. Since each individual carries two alleles per gene, if we know the allele frequencies (p and q), predicting the genotypes' frequencies is a simple mathematical calculation to determine the probability of obtaining these genotypes if we draw two alleles at random from the gene pool. In the above scenario, an individual pea plant could be pp (YY), and thus produce yellow peas; pq (Yy), also yellow; or qq (yy), and thus produce green peas (Figure 19.2). In other words, the frequency of pp individuals is simply p2; the frequency of pq individuals is 2pq; and the frequency of qq individuals is q2. Again, if p and q are the only two possible alleles for a given trait in the population, these genotypes frequencies will sum to one: p2 + 2pq + q2 = 1."}],"visibility":"public"},{"contentHash":"sha256:a78c8940f179befc7e4e0d92a1cd01ecf8202ac0c01668c9d54dc0d9957813b7","edition":"urn:openstax:clir:biology-evolution#S_19_2_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-evolution#PIN_NONRANDOM_MATING","kind":"fragment","locator":"section/19.2#pin_nonrandom_mating","package":"urn:openstax:clir:biology-evolution","texts":[{"contentHash":"sha256:b50faf23221d70ee975d58a9ae46419eca0cfeaf944423a8d977afc395af59a8","language":"en","status":"official","text":"If individuals nonrandomly mate with their peers, the result can be a changing population. There are many reasons nonrandom mating occurs. One reason is simple mate choice. For example, female peahens may prefer peacocks with bigger, brighter tails. Natural selection picks traits that lead to more mating selections for an individual. One common form of mate choice, called assortative mating, is an individual’s preference to mate with partners who are phenotypically similar to themselves."}],"visibility":"public"},{"anchors":["urn:openstax:clir:biology-evolution#PIN_NONRANDOM_MATING"],"body":{"formula":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-evolution#random_mating"},"kind":"status","status":"established"},"contentHash":"sha256:e7ffe39192263f03ef026009524f1f7cd1fd72869beaf0f4cfabf74201f41422","head":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-evolution#random_mating_established"},"id":"urn:openstax:clir:biology-evolution#RandomMatingEstablished","interpretations":[],"kind":"rule","labels":[{"language":"en","status":"unofficial","text":"random mating is an explicit prerequisite"}],"package":"urn:openstax:clir:biology-evolution","scope":{"kind":"boolean","value":true},"strength":"strict","variables":[{"id":"v0","type":{"name":"calc.population_models#PMCase"}}],"visibility":"public"},{"contentHash":"sha256:cfd37127d4e2295d21a51557f8d22bb4ee5683c633d19c786a84ca8f532f91ed","id":"urn:openstax:clir:biology-evolution#S_19_1_EN","kind":"source_edition","language":"en","lifecycle":[{"extent":"2018-03-28","status":"adopted"},{"extent":{"axis":"legal_time","endInclusive":false,"start":"2018-03-28","startInclusive":true},"status":"in_force"}],"materializationStatus":"PINNED_UNOFFICIAL_COPY","officiality":"official","package":"urn:openstax:clir:biology-evolution","work":"urn:openstax:clir:biology-evolution#S_19_1_WORK"},{"contentHash":"sha256:46a165fb1b3277577aefcd46c0ebba7b6d54d94df9ce04c07abb38b56cfe61c1","documentHash":"sha256:820305db47dd7dbeb27d234bd0d739f19394dd8eaa1f1174c5c09e9cb05d0f60","edition":"urn:openstax:clir:biology-evolution#S_19_1_EN","id":"urn:openstax:clir:biology-evolution#S_19_1_TEXT","kind":"publication","mediaType":"text/plain; charset=utf-8","package":"urn:openstax:clir:biology-evolution","retrievedAt":"2026-10-14T15:36:03Z","uri":"https://openstax.org/books/biology-2e/pages/19-1-population-evolution"},{"contentHash":"sha256:d970fe8fd1c848d0e4ba92e42d396ff33b42073ac9131cf8d4bb479b87cedfcd","id":"urn:openstax:clir:biology-evolution#S_19_1_WORK","jurisdiction":{"kind":"value","type":{"name":"urn:law:std#Text"},"value":"none"},"kind":"source_work","labels":[{"language":"en","status":"official","text":"OpenStax Biology 2e section 19.1"}],"number":"Biology 2e section 19.1","package":"urn:openstax:clir:biology-evolution","sourceKind":"urn:openstax:clir:biology-evolution#treatise"},{"contentHash":"sha256:76b20d76684a121ef097c3cd42299f4f195d14d90952d903d827e692a9735a99","id":"urn:openstax:clir:biology-evolution#S_19_2_EN","kind":"source_editi