logy#generation_horizon"},"kind":"status","status":"established"},{"formula":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-ecology#bacterial_doubling_profile"},"kind":"status","status":"established"},{"formula":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-ecology#unlimited_resources"},"kind":"status","status":"established"},{"formula":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-ecology#initial_population"},"kind":"status","status":"established"},{"kind":"comparison","left":{"input":{"binders":[],"distinct":true,"element":{"kind":"var","var":"v3"},"generator":{"formula":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v3"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-ecology#generation_horizon"},"kind":"status","status":"established"},"kind":"comprehension","variable":{"id":"v3","type":{"name":"urn:law:std#Integer"}}},"kind":"aggregate","op":"count"},"op":"eq","right":{"kind":"value","type":{"name":"urn:law:std#Number"},"value":"1/1"}},{"kind":"comparison","left":{"kind":"var","var":"v2"},"op":"le","right":{"kind":"value","type":{"name":"urn:law:std#Number"},"value":"24/1"}}],"kind":"and"},"contentHash":"sha256:49469d4082175c7e6e125bb657212759d773cbf4a4ba616a6ec731e77a80ee80","head":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-ecology#doubling_licensed"},"id":"urn:openstax:clir:biology-ecology#DoublingLicensed","interpretations":[],"kind":"rule","labels":[{"language":"en","status":"unofficial","text":"the doubling profile, resource assumption and bounded inputs are established"}],"package":"urn:openstax:clir:biology-ecology","scope":{"kind":"boolean","value":true},"strength":"strict","variables":[{"id":"v0","type":{"name":"calc.population_models#PMCase"}},{"id":"v1","type":{"name":"urn:law:std#Integer"}},{"id":"v2","type":{"name":"urn:law:std#Integer"}}],"visibility":"public"},{"contentHash":"sha256:dbdeaf69ab79abde0f4e68f5ca86a407622951a35ceb16f485f1b84d2f5814c3","edition":"urn:openstax:clir:biology-ecology#S_46_1_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-ecology#PIN_CHAIN","kind":"fragment","locator":"section/46.1#pin_chain","package":"urn:openstax:clir:biology-ecology","texts":[{"contentHash":"sha256:0843abd268e5b2255553b90b3ab1d18cb6a551cccb9b1a46cf9762b4bbc510aa","language":"en","status":"official","text":"The scientific understanding of a food chain is more precise than in its everyday usage. In ecology, a food chain is a linear sequence of organisms through which nutrients and energy pass: primary producers, primary consumers, and higher-level consumers are used to describe ecosystem structure and dynamics. There is a single path through the chain. Each organism in a food chain occupies what is called a trophic level. Depending on their role as producers or consumers, species or groups of species can be assigned to various trophic levels."}],"visibility":"public"},{"contentHash":"sha256:e2717a7d061d2f3aaac3d79f5e6035136f9f1e4d0625303b86d97af2f099cdec","edition":"urn:openstax:clir:biology-ecology#S_45_3_EN","fragmentKind":"paragraph","id":"urn:openstax:clir:biology-ecology#PIN_DOUBLING","kind":"fragment","locator":"section/45.3#pin_doubling","package":"urn:openstax:clir:biology-ecology","texts":[{"contentHash":"sha256:ffa013ecd2b65488c0d362e4149011847026c349d413b7c753ca64be1b7c0956","language":"en","status":"official","text":"The best example of exponential growth is seen in bacteria. Bacteria reproduce by prokaryotic fission. This division takes about an hour for many bacterial species. If 1000 bacteria are placed in a large flask with an unlimited supply of nutrients (so the nutrients will not become depleted), after an hour, there is one round of division and each organism divides, resulting in 2000 organisms—an increase of 1000. In another hour, each of the 2000 organisms will double, producing 4000, an increase of 2000 organisms. After the third hour, there should be 8000 bacteria in the flask, an increase of 4000 organisms. The important concept of exponential growth is the accelerating population growth rate—the number of organisms added in each reproductive generation—that is, it is increasing at a greater and greater rate. After 1 day and 24 of these cycles, the population would have increased from 1000 to more than 16 billion. When the population size, N, is plotted over time, a J-shaped growth curve is produced (Figure 45.9)."}],"visibility":"public"},{"anchors":["urn:openstax:clir:biology-ecology#PIN_DOUBLING"],"body":{"items":[{"formula":{"args":[{"kind":"var","var":"v0"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-ecology#doubling_licensed"},"kind":"status","status":"established"},{"formula":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"},{"kind":"var","var":"v2"}],"kind":"literal","polarity":"positive","predicate":"urn:law:calc:population-models#pm_derived_traj"},"kind":"status","status":"established"}],"kind":"and"},"contentHash":"sha256:bd7f3c344e03070db7e7f6c7efb42eeddd8c30ff5e0e4c312ff78bee3659bcb3","head":{"args":[{"kind":"var","var":"v0"},{"kind":"var","var":"v1"},{"kind":"var","var":"v2"}],"kind":"literal","polarity":"positive","predicate":"urn:openstax:clir:biology-ecology#population_at_generation"},"id":"urn:openstax:clir:biology-ecology#PopulationAtGeneration","interpretations":[],"kind":"rule","labels":[{"language":"en","status":"unofficial","text":"return the native computed generation count"}],"package":"urn:openstax:clir:biology-ecology","scope":{"kind":"boolean","value":true},"strength":"strict","variables":[{"id":"v0","type":{"name":"calc.population_models#PMCase"}},{"id":"v1","type":{"name":"urn:law:std#Integer"}},{"id":"v2","type":{"name":"urn:la